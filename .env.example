CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

MYSQL_DATABASE=database_name
MYSQL_USER=your_username
MYSQL_PASSWORD=username_password
MYSQL_ROOT_PASSWORD=your_root_password

DB_NAME=database_name
